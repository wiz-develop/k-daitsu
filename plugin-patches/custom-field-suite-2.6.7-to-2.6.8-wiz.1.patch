+    protected function normalize_ids( $value ) {
+        $values = is_array( $value ) ? $value : explode( ',', (string) $value );
+        $ids = [];
+
+        array_walk_recursive( $values, function( $item ) use ( &$ids ) {
+            $id = absint( $item );
